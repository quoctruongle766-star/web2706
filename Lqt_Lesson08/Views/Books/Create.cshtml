@model Book
@{
    ViewData["Title"] = "Thêm sách";
}
<h1>Thêm sách</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="BookId" class="form-label"></label>
    <input asp-for="BookId" class="form-control" />
    <span asp-validation-for="BookId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Author" class="form-label"></label>
    <input asp-for="Author" class="form-control" />
    <span asp-validation-for="Author" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="Release" class="form-label"></label><input asp-for="Release" class="form-control" /></div>
    <div class="col-md-4 mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /></div>
    <div class="col-md-4 mb-3"><label asp-for="Picture" class="form-label"></label><input asp-for="Picture" class="form-control" /></div>
</div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
<div class="row">
    <div class="col-md-6 mb-3"><label class="form-label">Nhà xuất bản</label><select asp-for="PublisherId" class="form-select" asp-items="ViewBag.PublisherId"><option value="">-- Chọn nhà xuất bản --</option></select></div>
    <div class="col-md-6 mb-3"><label class="form-label">Thể loại</label><select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"><option value="">-- Chọn thể loại --</option></select></div>
</div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
