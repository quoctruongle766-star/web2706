@model Book
@{
    ViewData["Title"] = "Chi tiết sách";
}
<h1>Chi tiết sách</h1>
<dl class="row">
    <dt class="col-sm-3">Mã sách</dt><dd class="col-sm-9">@Model.BookId</dd>
    <dt class="col-sm-3">Tên sách</dt><dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Tác giả</dt><dd class="col-sm-9">@Model.Author</dd>
    <dt class="col-sm-3">Năm phát hành</dt><dd class="col-sm-9">@Model.Release</dd>
    <dt class="col-sm-3">Giá</dt><dd class="col-sm-9">@(Model.Price?.ToString("N0")) đ</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Nhà xuất bản</dt><dd class="col-sm-9">@Model.Publisher?.PublisherName</dd>
    <dt class="col-sm-3">Thể loại</dt><dd class="col-sm-9">@Model.Category?.CategoryName</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
