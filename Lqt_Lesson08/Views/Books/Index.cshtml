@model IEnumerable<Book>
@{
    ViewData["Title"] = "Danh sách sách";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách sách</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm sách</a>
</div>
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8"><input name="searchString" value="@ViewData["SearchString"]" class="form-control" placeholder="Tìm theo tên sách hoặc tác giả..." /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a></div>
</form>
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark"><tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Năm</th><th>Giá</th><th>Thể loại</th><th>Nhà xuất bản</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.BookId</td><td>@item.Title</td><td>@item.Author</td><td>@item.Release</td>
            <td>@(item.Price?.ToString("N0")) đ</td><td>@item.Category?.CategoryName</td><td>@item.Publisher?.PublisherName</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.BookId">Xem</a> |
                <a asp-action="Edit" asp-route-id="@item.BookId">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.BookId">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
