<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LqtBookStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Books" asp-action="Index">LqtBookStore</a>
            <span class="navbar-text text-light">Quốc Trưởng</span>
        </div>
    </nav>
</header>
<main class="container pb-4">
    @if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
    @RenderBody()
</main>
<footer class="border-top text-muted py-3">
    <div class="container">LqtBookStore - Thực hiện: Quốc Trưởng</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
